        </Button>

        <!-- Nuevo Botón de Ver Promociones -->
        <Button fx:id="btnVerPromociones" layoutX="178.0" layoutY="238.0" mnemonicParsing="false" onAction="#onActionVerPromociones" prefHeight="26.0" prefWidth="143.0" text="Ver Promociones">
            <font>
                <Font name="Times New Roman Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnCerrarSesion" layoutX="178.0" layoutY="280.0" mnemonicParsing="false" onAction="#onActionCerrarSesion" prefHeight="26.0" prefWidth="143.0" text="Cerrar Sesion">
