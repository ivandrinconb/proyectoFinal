<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="380.0" prefWidth="505.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.controller.DashBoardClienteController">
    <children>
        <Text layoutX="202.0" layoutY="32.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Bienvenido.">
            <font>
                <Font name="Times New Roman Bold" size="20.0" />
            </font>
        </Text>
        <Separator layoutX="12.0" layoutY="42.0" prefHeight="0.0" prefWidth="474.0" />

        <Button fx:id="btnReservarHabitacion" layoutX="180.0" layoutY="70.0" mnemonicParsing="false" onAction="#onActionReservarHabitacion" prefHeight="26.0" prefWidth="143.0" text="Reservar Habitacion">
            <font>
                <Font name="Times New Roman Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnMisReservas" layoutX="180.0" layoutY="112.0" mnemonicParsing="false" onAction="#onActionMisReservas" prefHeight="26.0" prefWidth="143.0" text="Mis Reservas">
            <font>
                <Font name="Times New Roman Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnTarjetaVirtual" layoutX="179.0" layoutY="154.0" mnemonicParsing="false" onAction="#onActionTarjetaVirtual" prefHeight="26.0" prefWidth="143.0" text="Mi Tarjeta Virtual">
